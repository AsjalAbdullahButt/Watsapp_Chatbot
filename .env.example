# Copy to .env and fill in. Never commit .env.
APP_ENV=dev
LOG_LEVEL=INFO

# Meta WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API Setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# Groq (console.groq.com > API Keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Your data file (same shape as data/sample_data.json)
DATA_FILE=data/sample_data.json

# Abuse protection (optional)
RATE_LIMIT_MESSAGES=10
RATE_LIMIT_WINDOW_SECONDS=60
MAX_TRACKED_PHONES=10000
